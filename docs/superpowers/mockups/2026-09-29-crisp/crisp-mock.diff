+// 임시(비교 캡처 전용, 커밋 안 함): 주소 스위치로 첫 화면 공항 모양을 바꿔 본다.
+const q = typeof window === 'undefined' ? new URLSearchParams() : new URLSearchParams(window.location.search);
+const all = q.get('all') === '1';
+export const CRISP = {
+  dpr2: all || q.get('dpr') === '2',
+  fadeSoft: all || q.get('fade') === 'soft',
+  core: all || q.get('core') === 'crisp',
+  refl: all || q.get('refl') === '1',
+  sky: all || q.get('sky') === 'mock',
+  color: all || q.get('color') === 'srgb',
+  still: q.get('still') === '1', // 신호 물결 끔(캡처끼리 같은 순간이 되게)
+};
+if (typeof document !== 'undefined') {
+  if (CRISP.sky) document.documentElement.dataset.sky = 'mock';
+}
